generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  FINANCIAL
}

enum SoftwareType {
  SAAS
  CUSTOM
}

enum ContractType {
  SAAS_SUBSCRIPTION
  MAINTENANCE
  CUSTOM_DEVELOPMENT
}

enum PaymentStatus {
  PAID
  PENDING
  CANCELLED
}

enum Currency {
  ARS
  USD
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
  PARTNER_PAYOUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum AccountProvider {
  UALA
  BANK
  CASH
  OTHER
}

enum TransactionSource {
  MANUAL
  INVOICE
  TRANSFER
  UALA_IMPORT
  UALA_WEBHOOK
  PAYOUT
  RECURRING_EXPENSE
  ADJUSTMENT
  YIELD
}

enum RateSource {
  MANUAL
  API
}

enum ReminderKind {
  BEFORE_DUE
  DUE_DAY
  OVERDUE
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  LIVE
  MAINTENANCE
  PAUSED
  CLOSED
}

enum ComponentKind {
  WEB
  MOBILE
  BACKEND
  ADMIN
  INTEGRATION
  OTHER
}

enum TaskType {
  COLLECTION
  MESSAGE
  CALL
  MEETING
  RENEWAL
  FOLLOW_UP
  OTHER
}

enum TaskStatus {
  PENDING
  DONE
  CANCELLED
}

enum TaskRecurrence {
  NONE
  WEEKLY
  MONTHLY
  YEARLY
}

enum ClientStage {
  PROSPECT
  CLIENT
}

enum PayoutStatus {
  PENDING
  PAID
  RETAINED
}

enum ExpenseFrequency {
  MONTHLY
  YEARLY
}

enum OccurrenceStatus {
  PENDING
  PAID
  SKIPPED
}

enum BillingMode {
  FLEXIBLE
  INSTALLMENTS
}

enum InteractionType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
}

model User {
  id                      String              @id @default(cuid())
  email                   String              @unique
  password                String
  name                    String
  role                    Role
  transactions            Transaction[]
  assignedTasks           Task[]              @relation("TaskAssignee")
  createdTasks            Task[]              @relation("TaskCreator")
  interactions            ClientInteraction[]
  cancelledInvoices       Invoice[]           @relation("InvoiceCanceller")
  splitShares             SplitShare[]
  payouts                 Payout[]
  paymentsCreated         Payment[]           @relation("PaymentCreator")
  paymentsReversed        Payment[]           @relation("PaymentReverser")
  partnerPayments         PartnerPayment[]    @relation("PartnerPaymentPartner")
  partnerPaymentsCreated  PartnerPayment[]    @relation("PartnerPaymentCreator")
  partnerPaymentsReversed PartnerPayment[]    @relation("PartnerPaymentReverser")
  auditLogs               AuditLog[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}

model Client {
  id            String              @id @default(cuid())
  companyName   String
  contactName   String
  email         String?             @unique
  phone         String?
  stage         ClientStage         @default(PROSPECT)
  convertedAt   DateTime?
  website       String?
  instagram     String?
  facebook      String?
  linkedin      String?
  tiktok        String?
  x             String?
  status        Boolean             @default(true)
  lastContactAt DateTime?
  contracts     Contract[]
  payments      Payment[]
  tickets       Ticket[]
  projects      Project[]
  tasks         Task[]
  interactions  ClientInteraction[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@index([deletedAt])
  @@index([stage])
}

model Software {
  id          String             @id @default(cuid())
  name        String
  description String?
  type        SoftwareType
  basePrice   Decimal            @db.Decimal(12, 2)
  contracts   Contract[]
  tickets     Ticket[]
  components  ProjectComponent[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model Contract {
  id          String       @id @default(cuid())
  clientId    String
  softwareId  String
  projectId   String?
  type        ContractType
  totalAmount Decimal      @db.Decimal(12, 2)
  currency    Currency
  active      Boolean      @default(true)
  startDate   DateTime
  endDate     DateTime?
  paymentDay  Int?
  billingMode BillingMode  @default(INSTALLMENTS)
  invoices    Invoice[]
  payments    Payment[]
  splitShares SplitShare[]
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  software    Software     @relation(fields: [softwareId], references: [id], onDelete: Restrict)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@index([softwareId])
  @@index([projectId])
  @@index([active])
  @@index([deletedAt])
}

model Invoice {
  id            String              @id @default(cuid())
  contractId    String
  amount        Decimal             @db.Decimal(12, 2)
  paidAmount    Decimal             @default(0) @db.Decimal(12, 2)
  dueDate       DateTime
  status        PaymentStatus       @default(PENDING)
  currency      Currency
  period        String
  paymentDate   DateTime?
  rateToArs     Decimal?            @db.Decimal(14, 4)
  recurringKey  String?             @unique
  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  allocations   PaymentAllocation[]
  reminders     ReminderLog[]
  tasks         Task[]
  payouts       Payout[]
  contract      Contract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  cancelledBy   User?               @relation("InvoiceCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([contractId])
  @@index([status])
  @@index([dueDate])
  @@index([period])
}

model FinancialAccount {
  id                String             @id @default(cuid())
  name              String             @unique
  provider          AccountProvider
  currency          Currency
  openingBalance    Decimal            @default(0) @db.Decimal(14, 2)
  openingDate       DateTime
  active            Boolean            @default(true)
  earnsYield        Boolean            @default(false)
  reconciledAt      DateTime?
  reconciledBalance Decimal?           @db.Decimal(14, 2)
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  payments          Payment[]
  partnerPayments   PartnerPayment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model TransactionCategory {
  id                String             @id @default(cuid())
  name              String
  type              TransactionType
  active            Boolean            @default(true)
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([name, type])
}

model ExchangeRate {
  id        String     @id @default(cuid())
  date      DateTime   @db.Date
  currency  Currency
  rateToArs Decimal    @db.Decimal(14, 4)
  source    RateSource
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([currency, date])
}

model Transaction {
  id                String               @id @default(cuid())
  type              TransactionType
  accountId         String
  categoryId        String?
  amount            Decimal              @db.Decimal(12, 2)
  currency          Currency
  rateToArs         Decimal              @default(1) @db.Decimal(14, 4)
  amountArs         Decimal              @db.Decimal(14, 2)
  description       String?
  date              DateTime
  source            TransactionSource    @default(MANUAL)
  reconciled        Boolean              @default(false)
  externalId        String?              @unique
  transferGroupId   String?
  createdById       String?
  account           FinancialAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category          TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy         User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payment           Payment?
  partnerPayment    PartnerPayment?
  expenseOccurrence ExpenseOccurrence?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([date])
  @@index([type])
  @@index([accountId])
  @@index([categoryId])
  @@index([transferGroupId])
}

model Ticket {
  id          String         @id @default(cuid())
  clientId    String
  softwareId  String
  projectId   String?
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  software    Software       @relation(fields: [softwareId], references: [id], onDelete: Restrict)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([clientId])
  @@index([softwareId])
  @@index([projectId])
  @@index([status])
}

model ReminderLog {
  id         String              @id @default(cuid())
  invoiceId  String
  kind       ReminderKind
  channel    NotificationChannel
  status     ReminderStatus      @default(PENDING)
  recipient  String
  providerId String?
  error      String?
  attempts   Int                 @default(0)
  sentAt     DateTime?
  invoice    Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([invoiceId, kind, channel])
  @@index([status])
}

model Project {
  id          String             @id @default(cuid())
  clientId    String
  name        String
  description String?
  status      ProjectStatus      @default(IN_PROGRESS)
  startDate   DateTime?
  endDate     DateTime?
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  components  ProjectComponent[]
  contracts   Contract[]
  tickets     Ticket[]
  tasks       Task[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@index([deletedAt])
}

model ProjectComponent {
  id         String        @id @default(cuid())
  projectId  String
  name       String
  kind       ComponentKind
  softwareId String?
  url        String?
  repoUrl    String?
  notes      String?
  active     Boolean       @default(true)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  software   Software?     @relation(fields: [softwareId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([projectId])
  @@index([softwareId])
}

model Task {
  id           String         @id @default(cuid())
  title        String
  notes        String?
  type         TaskType
  status       TaskStatus     @default(PENDING)
  dueAt        DateTime
  recurrence   TaskRecurrence @default(NONE)
  assignedToId String?
  createdById  String?
  clientId     String?
  projectId    String?
  invoiceId    String?
  completedAt  DateTime?
  notifiedAt   DateTime?
  assignedTo   User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  invoice      Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, dueAt])
  @@index([assignedToId])
  @@index([clientId])
  @@index([projectId])
  @@index([invoiceId])
}

model ClientInteraction {
  id         String          @id @default(cuid())
  clientId   String
  userId     String?
  type       InteractionType
  note       String
  occurredAt DateTime
  client     Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([clientId, occurredAt])
}

model SplitShare {
  id         String    @id @default(cuid())
  contractId String?
  userId     String?
  percent    Decimal   @db.Decimal(5, 2)
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([contractId])
}

model Payout {
  id        String       @id @default(cuid())
  paymentId String?
  invoiceId String?
  userId    String?
  percent   Decimal      @db.Decimal(5, 2)
  amount    Decimal      @db.Decimal(12, 2)
  currency  Currency
  amountArs Decimal      @db.Decimal(14, 2)
  status    PayoutStatus
  paidAt    DateTime?
  payment   Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice   Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  user      User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([paymentId])
  @@index([invoiceId])
  @@index([userId, status])
}

model Payment {
  id              String              @id @default(cuid())
  clientId        String
  contractId      String
  accountId       String
  amount          Decimal             @db.Decimal(12, 2)
  currency        Currency
  rateToArs       Decimal             @default(1) @db.Decimal(14, 4)
  amountArs       Decimal             @db.Decimal(14, 2)
  appliedAmount   Decimal             @db.Decimal(12, 2)
  appliedCurrency Currency
  date            DateTime
  notes           String?
  transactionId   String?             @unique
  createdById     String?
  reversedAt      DateTime?
  reversedById    String?
  reverseReason   String?
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contract        Contract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  account         FinancialAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction     Transaction?        @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reversedBy      User?               @relation("PaymentReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  allocations     PaymentAllocation[]
  payouts         Payout[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([clientId, date])
  @@index([contractId])
  @@index([reversedAt])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model PartnerPayment {
  id            String           @id @default(cuid())
  userId        String
  accountId     String
  amount        Decimal          @db.Decimal(12, 2)
  currency      Currency
  rateToArs     Decimal          @default(1) @db.Decimal(14, 4)
  amountArs     Decimal          @db.Decimal(14, 2)
  date          DateTime
  concept       String?
  transactionId String?          @unique
  createdById   String?
  reversedAt    DateTime?
  reversedById  String?
  reverseReason String?
  user          User             @relation("PartnerPaymentPartner", fields: [userId], references: [id], onDelete: Restrict)
  account       FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction   Transaction?     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdBy     User?            @relation("PartnerPaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reversedBy    User?            @relation("PartnerPaymentReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId, date])
  @@index([reversedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  summary   String
  diff      Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
}

model RecurringExpense {
  id          String              @id @default(cuid())
  name        String
  amount      Decimal             @db.Decimal(12, 2)
  currency    Currency
  accountId   String
  categoryId  String
  frequency   ExpenseFrequency    @default(MONTHLY)
  dayOfMonth  Int
  month       Int?
  autoRecord  Boolean             @default(false)
  active      Boolean             @default(true)
  startDate   DateTime
  notes       String?
  account     FinancialAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category    TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  occurrences ExpenseOccurrence[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([active])
}

model ExpenseOccurrence {
  id                 String           @id @default(cuid())
  recurringExpenseId String
  period             String
  dueDate            DateTime
  expectedAmount     Decimal          @db.Decimal(12, 2)
  status             OccurrenceStatus @default(PENDING)
  paidAt             DateTime?
  transactionId      String?          @unique
  skipReason         String?
  recurringExpense   RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Restrict)
  transaction        Transaction?     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([recurringExpenseId, period])
  @@index([status, dueDate])
}
