generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  FINANCIAL
}

enum SoftwareType {
  SAAS
  CUSTOM
}

enum ContractType {
  SAAS_SUBSCRIPTION
  MAINTENANCE
  CUSTOM_DEVELOPMENT
}

enum PaymentStatus {
  PAID
  PENDING
}

enum Currency {
  ARS
  USD
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
}

enum AccountProvider {
  UALA
  BANK
  CASH
  OTHER
}

enum TransactionSource {
  MANUAL
  INVOICE
  TRANSFER
  UALA_IMPORT
  UALA_WEBHOOK
}

enum RateSource {
  MANUAL
  API
}

enum ReminderKind {
  BEFORE_DUE
  DUE_DAY
  OVERDUE
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  LIVE
  MAINTENANCE
  PAUSED
  CLOSED
}

enum ComponentKind {
  WEB
  MOBILE
  BACKEND
  ADMIN
  INTEGRATION
  OTHER
}

enum TaskType {
  COLLECTION
  MESSAGE
  CALL
  MEETING
  RENEWAL
  FOLLOW_UP
  OTHER
}

enum TaskStatus {
  PENDING
  DONE
  CANCELLED
}

enum TaskRecurrence {
  NONE
  WEEKLY
  MONTHLY
  YEARLY
}

enum ClientStage {
  PROSPECT
  CLIENT
}

enum InteractionType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  password      String
  name          String
  role          Role
  transactions  Transaction[]
  assignedTasks Task[]              @relation("TaskAssignee")
  createdTasks  Task[]              @relation("TaskCreator")
  interactions  ClientInteraction[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Client {
  id            String              @id @default(cuid())
  companyName   String
  contactName   String
  email         String?             @unique
  phone         String?
  stage         ClientStage         @default(PROSPECT)
  convertedAt   DateTime?
  website       String?
  instagram     String?
  facebook      String?
  linkedin      String?
  tiktok        String?
  x             String?
  status        Boolean             @default(true)
  lastContactAt DateTime?
  contracts     Contract[]
  tickets       Ticket[]
  projects      Project[]
  tasks         Task[]
  interactions  ClientInteraction[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@index([deletedAt])
  @@index([stage])
}

model Software {
  id          String             @id @default(cuid())
  name        String
  description String?
  type        SoftwareType
  basePrice   Decimal            @db.Decimal(12, 2)
  contracts   Contract[]
  tickets     Ticket[]
  components  ProjectComponent[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model Contract {
  id          String       @id @default(cuid())
  clientId    String
  softwareId  String
  projectId   String?
  type        ContractType
  totalAmount Decimal      @db.Decimal(12, 2)
  currency    Currency
  active      Boolean      @default(true)
  startDate   DateTime
  endDate     DateTime?
  invoices    Invoice[]
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  software    Software     @relation(fields: [softwareId], references: [id], onDelete: Restrict)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@index([softwareId])
  @@index([projectId])
  @@index([active])
  @@index([deletedAt])
}

model Invoice {
  id           String        @id @default(cuid())
  contractId   String
  amount       Decimal       @db.Decimal(12, 2)
  dueDate      DateTime
  status       PaymentStatus @default(PENDING)
  currency     Currency
  period       String
  paymentDate  DateTime?
  rateToArs    Decimal?      @db.Decimal(14, 4)
  recurringKey String?       @unique
  transaction  Transaction?
  reminders    ReminderLog[]
  tasks        Task[]
  contract     Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([contractId])
  @@index([status])
  @@index([dueDate])
  @@index([period])
}

model FinancialAccount {
  id             String          @id @default(cuid())
  name           String          @unique
  provider       AccountProvider
  currency       Currency
  openingBalance Decimal         @default(0) @db.Decimal(14, 2)
  openingDate    DateTime
  active         Boolean         @default(true)
  transactions   Transaction[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TransactionCategory {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  active       Boolean         @default(true)
  transactions Transaction[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([name, type])
}

model ExchangeRate {
  id        String     @id @default(cuid())
  date      DateTime   @db.Date
  currency  Currency
  rateToArs Decimal    @db.Decimal(14, 4)
  source    RateSource
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([currency, date])
}

model Transaction {
  id              String               @id @default(cuid())
  type            TransactionType
  accountId       String
  categoryId      String?
  amount          Decimal              @db.Decimal(12, 2)
  currency        Currency
  rateToArs       Decimal              @default(1) @db.Decimal(14, 4)
  amountArs       Decimal              @db.Decimal(14, 2)
  description     String?
  date            DateTime
  source          TransactionSource    @default(MANUAL)
  reconciled      Boolean              @default(false)
  invoiceId       String?              @unique
  externalId      String?              @unique
  transferGroupId String?
  createdById     String?
  account         FinancialAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category        TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  invoice         Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy       User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([date])
  @@index([type])
  @@index([accountId])
  @@index([categoryId])
  @@index([transferGroupId])
}

model Ticket {
  id          String         @id @default(cuid())
  clientId    String
  softwareId  String
  projectId   String?
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  software    Software       @relation(fields: [softwareId], references: [id], onDelete: Restrict)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([clientId])
  @@index([softwareId])
  @@index([projectId])
  @@index([status])
}

model ReminderLog {
  id         String              @id @default(cuid())
  invoiceId  String
  kind       ReminderKind
  channel    NotificationChannel
  status     ReminderStatus      @default(PENDING)
  recipient  String
  providerId String?
  error      String?
  attempts   Int                 @default(0)
  sentAt     DateTime?
  invoice    Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([invoiceId, kind, channel])
  @@index([status])
}

model Project {
  id          String             @id @default(cuid())
  clientId    String
  name        String
  description String?
  status      ProjectStatus      @default(IN_PROGRESS)
  startDate   DateTime?
  endDate     DateTime?
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  components  ProjectComponent[]
  contracts   Contract[]
  tickets     Ticket[]
  tasks       Task[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@index([deletedAt])
}

model ProjectComponent {
  id         String        @id @default(cuid())
  projectId  String
  name       String
  kind       ComponentKind
  softwareId String?
  url        String?
  repoUrl    String?
  notes      String?
  active     Boolean       @default(true)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  software   Software?     @relation(fields: [softwareId], references: [id], onDelete: Restrict)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([projectId])
  @@index([softwareId])
}

model Task {
  id           String         @id @default(cuid())
  title        String
  notes        String?
  type         TaskType
  status       TaskStatus     @default(PENDING)
  dueAt        DateTime
  recurrence   TaskRecurrence @default(NONE)
  assignedToId String?
  createdById  String?
  clientId     String?
  projectId    String?
  invoiceId    String?
  completedAt  DateTime?
  notifiedAt   DateTime?
  assignedTo   User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  invoice      Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, dueAt])
  @@index([assignedToId])
  @@index([clientId])
  @@index([projectId])
  @@index([invoiceId])
}

model ClientInteraction {
  id         String          @id @default(cuid())
  clientId   String
  userId     String?
  type       InteractionType
  note       String
  occurredAt DateTime
  client     Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([clientId, occurredAt])
}
